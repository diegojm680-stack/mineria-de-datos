import pandas as pd
import matplotlib.pyplot as plt
from collections import Counter

df = pd.read_csv("practica_mineria_textos_redes_sociales.csv")

print("Primeras filas del dataset:")
print(df.head())

print("\nCantidad de registros:")
print(len(df))

df["Texto_Publicacion"] = df["Texto_Publicacion"].fillna("").astype(str)
df["Hashtags"] = df["Hashtags"].fillna("").astype(str)
df["Tema_Referencia"] = df["Tema_Referencia"].fillna("Sin tema")
df["Sentimiento_Referencia"] = df["Sentimiento_Referencia"].fillna("neutral")

texto_total = " ".join(df["Texto_Publicacion"]).lower()

for signo in [".", ",", ";", ":", "!", "?", "¿", "¡", "(", ")", '"']:
    texto_total = texto_total.replace(signo, "")

palabras = texto_total.split()

palabras_vacias = [
    "el", "la", "los", "las", "de", "del", "y", "a", "e", "en",
    "un", "una", "que", "fue", "con", "por", "para", "lo",
    "se", "su", "es", "al", "como", "más", "pero", "muy",
    "me", "mi", "nos", "no", "una", "este", "esta"
]

palabras_filtradas = [
    palabra for palabra in palabras
    if palabra not in palabras_vacias
]

conteo = Counter(palabras_filtradas)

print("\nTop 10 palabras frecuentes:")
print(conteo.most_common(10))

positivas = [
    "excelente", "buena", "bueno", "bien", "rápida", "rápido",
    "claro", "clara", "fácil", "mejor", "mejora", "funciona",
    "funcionando", "ordenada", "ordenado", "útil", "gracias",
    "agradable", "correcto", "correcta", "genial"
]

negativas = [
    "mala", "malo", "problema", "problemas", "falló", "fallo",
    "lenta", "lento", "confuso", "confusa", "difícil",
    "perdimos", "cerró", "cayó", "faltan", "falta",
    "error", "errores", "deficiente", "incompleto", "incompleta", "complicado",
    "complicada"
]


def analizar_sentimiento(texto):

    texto = str(texto).lower()

    for signo in [".", ",", ";", ":", "!", "?", "¿", "¡"]:
        texto = texto.replace(signo, "")

    palabras = texto.split()

    puntos_pos = sum(palabra in positivas for palabra in palabras)
    puntos_neg = sum(palabra in negativas for palabra in palabras)

    if puntos_pos > puntos_neg:
        return "positivo"
    elif puntos_neg > puntos_pos:
        return "negativo"
    else:
        return "neutral"


df["Sentimiento_Calculado"] = df["Texto_Publicacion"].apply(
    analizar_sentimiento
)


print("\nSentimientos calculados:")
print(df[[
    "Texto_Publicacion",
    "Sentimiento_Calculado"
]])

print("\nCantidad de sentimientos calculados:")
print(df["Sentimiento_Calculado"].value_counts())

df["Sentimiento_Calculado"].value_counts().plot(
    kind="bar"
)

plt.xlabel("Sentimiento")
plt.ylabel("Cantidad")
plt.title("Distribución de sentimientos calculados")
plt.show()

print("\nAnálisis por tema:")

analisis_tema = pd.crosstab(
    df["Tema_Referencia"],
    df["Sentimiento_Calculado"]
)

print(analisis_tema)

hashtags = []

for texto in df["Hashtags"]:

    palabras = str(texto).split()

    for palabra in palabras:

        palabra = palabra.strip()

        if palabra.startswith("#"):
            hashtags.append(palabra.lower())

conteo_hashtags = Counter(hashtags)

print("\nTop 10 hashtags:")
print(conteo_hashtags.most_common(10))

print("\nComparación entre sentimiento calculado y sentimiento de referencia:")

comparacion = df[[
    "Sentimiento_Referencia",
    "Sentimiento_Calculado"
]]

print(comparacion)

coincidencias = (
    df["Sentimiento_Referencia"] ==
    df["Sentimiento_Calculado"]
)

exactitud = coincidencias.mean()

print("\nPorcentaje de coincidencia:")
print(round(exactitud * 100, 2), "%")

print("\nTabla de comparación:")
print(
    pd.crosstab(
        df["Sentimiento_Referencia"],
        df["Sentimiento_Calculado"]
    )
)

